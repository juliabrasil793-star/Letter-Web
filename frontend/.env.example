# Endereço base da API usada pelo frontend.
# ATENÇÃO: variáveis VITE_* são incorporadas ao bundle durante o BUILD
# (npm run build). Alterar este valor exige gerar um novo build —
# mudar apenas a variável de ambiente em runtime não tem efeito.
# Deixe vazio para usar a mesma origem do frontend (ex.: backend atrás
# do mesmo domínio/proxy reverso).
VITE_API_BASE_URL=https://api.seudominio.com
