# Template de variáveis de ambiente.
# Configure os valores reais no painel da hospedagem.
# O Spring Boot não carrega arquivos .env automaticamente.

DB_HOST=seu-host-postgresql
DB_PORT=5432
DB_NAME=letterweb_db
DB_USERNAME=seu_usuario_postgresql
DB_PASSWORD=sua_senha_postgresql

# SPRING_PROFILES_ACTIVE deve ficar VAZIO em produção (não definir 'dev').
# O perfil 'dev' é apenas para desenvolvimento local (ativa ddl-auto=update
# e CORS para localhost). Em produção, deixe vazio ou use o perfil definido
# pela hospedagem.
SPRING_PROFILES_ACTIVE=

PORT=8080

# Configure os IPs confiáveis do proxy/CDN da hospedagem.
TRUSTED_PROXY_IPS=

# Informe o domínio real do frontend.
CORS_ALLOWED_ORIGINS=https://seu-dominio.com